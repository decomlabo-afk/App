# Clé secrète Stripe (Dashboard Stripe > Développeurs > Clés API)
# Commence par sk_test_ en mode test, sk_live_ en production
STRIPE_SECRET_KEY=sk_test_xxx

# Secret du webhook (Dashboard Stripe > Développeurs > Webhooks)
# Sert à compter les paiements réussis
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Adresse publique de ton site (sans / à la fin)
PUBLIC_URL=http://localhost:3000

PORT=3000
